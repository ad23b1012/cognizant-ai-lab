# Scheme Navigator (YojanaMitra AI) - Environment Configuration
# Copy this file to .env and configure your keys

# Google Gemini API Key (Required for Neuro-SAN agent chat)
# Obtain a free key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenRouter API Key (Optional: for fallback models)
# Obtain from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Neuro-SAN Runtime Settings
AGENT_MANIFEST_FILE=registries/manifest.hocon
AGENT_TOOL_PATH=coded_tools
PYTHONPATH=.
LOG_LEVEL=info
